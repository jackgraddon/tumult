# Local-only opencode config for Tumult — never commit
opencode.json
opencode.jsonc
opencode.json.bak

# Node
node_modules/
dist/
dist-types/
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# Vercel CLI metadata — a stale .vercel/ (from a local `vercel link`) points at
# the wrong project and silently breaks the tagged deploy; never commit it.
.vercel/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Playwright MCP scratch (page snapshots, traces)
.playwright-mcp/

# Local test homeserver (generated keys + sqlite db)
tests/synapse/data/
tests/rtc/data/
# Self-signed federation certificate, generated by tests/rtc/run.sh
tests/rtc/tls/
# Browser-test output (screenshots and logs from a failed run)
apps/web/test-results/

# Playwright live session state (contains tokens) — never commit
apps/web/test/.mas-session.json
apps/web/test/.live-session.json
