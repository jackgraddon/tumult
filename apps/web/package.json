{
  "name": "@tumult/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "pnpm --filter @tumult/core build && pnpm --filter @tumult/theme build",
    "build": "vue-tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json",
    "pretest:browser": "pnpm --filter @tumult/core build && pnpm --filter @tumult/theme build",
    "test:browser": "node --test --import tsx test/browser.test.ts",
    "test:live": "MAS_LIVE=1 node --test --import tsx test/mas-live.test.ts"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
    "@tumult/core": "workspace:*",
    "@tumult/theme": "workspace:*",
    "@tumult/ui": "workspace:*",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.1"
  }
}
