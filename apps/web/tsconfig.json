{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A leaf app: nothing imports its types, and Vite does the emitting.
    // Type-checking only, so no declaration output to litter the tree.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // Vite resolves imports here, not tsc, and the rewrite rule can't handle
    // `.vue` specifiers. Only packages that emit their own runtime JS need it.
    "rewriteRelativeImportExtensions": false,
    "jsx": "preserve",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@tumult/ui": ["../../packages/ui/src/index.ts"],
      // Typecheck against the real client; which one a *build* links is
      // vite.config.ts's business, and both implementations are typechecked
      // because both live under src/.
      "@chat-impl": ["./src/chat.real.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/theme" }]
}
