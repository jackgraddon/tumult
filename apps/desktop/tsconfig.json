{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Type-checking only: esbuild bundles the main process (scripts/build.ts),
    // Node runs the scripts, tests and the demo (demo/native-activity.ts) straight
    // from .ts.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "smoke/**/*.ts", "scripts/**/*.ts", "demo/**/*.ts"]
}
