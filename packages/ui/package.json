{
  "name": "@tumult/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sandbox": "./src/plugins/sandbox/worker/shim.ts",
    "./sandbox/frame": "./src/plugins/sandbox/frame.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "vue-tsc -p tsconfig.json && vue-tsc -p tsconfig.test.json && pnpm test:template",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"**/node_modules/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\"",
    "test:template": "vue-tsc -p ../../templates/plugin/tsconfig.json --noEmit && tsc -p ../../templates/plugin/tsconfig.workspace.json --noEmit",
    "emit:schema": "node --import tsx scripts/emit-plugin-schema.ts",
    "emit:icons": "node --import tsx scripts/emit-icons.ts",
    "emit:types": "node --import tsx scripts/emit-plugin-types.ts"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-virtual": "^3.13.39",
    "@tumult/core": "workspace:*",
    "@tumult/theme": "workspace:*",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.1"
  }
}
