{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@tumult/core": ["../core/src/index.ts"],
      "@tumult/core/selectors": ["../core/src/selectors/spaceTree.ts"],
      "@tumult/core/media": ["../core/src/media/classify.ts"],
      "@tumult/core/*": ["../core/src/*"]
    }  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
