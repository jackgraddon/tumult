{
  "name": "@tumult/theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./themes/*.json": "./themes/*.json",
    "./dist/themes/*.css": "./dist/themes/*.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "themes"
  ],
  "scripts": {
    "build": "tsc -b && node ./dist/build/cli.js",
    "typecheck": "tsc -b && vue-tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"**/node_modules/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.1.1"
  }
}
