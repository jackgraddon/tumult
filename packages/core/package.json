{
  "name": "@tumult/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake/index.d.ts",
      "import": "./dist/fake/index.js"
    },
    "./selectors": {
      "types": "./dist/selectors/spaceTree.d.ts",
      "import": "./dist/selectors/spaceTree.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test test/",
    "test:integration": "node --test test-integration/"
  },
  "dependencies": {
    "matrix-js-sdk": "^43.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
