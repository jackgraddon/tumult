{
  "name": "@tumult/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake/index.d.ts",
      "import": "./dist/fake/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./selectors": {
      "types": "./dist/selectors/spaceTree.d.ts",
      "import": "./dist/selectors/spaceTree.js"
    },
    "./media": {
      "types": "./dist/media/classify.d.ts",
      "import": "./dist/media/classify.js"
    },
    "./session": {
      "types": "./dist/auth/session.d.ts",
      "import": "./dist/auth/session.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:integration": "node --test \"test-integration/**/*.test.ts\""
  },
  "dependencies": {
    "matrix-js-sdk": "^43.0.0",
    "matrix-widget-api": "^1.19.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
